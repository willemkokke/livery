{
  // Composed by `fm sync` from the base's template and what the
  // listed extensions and the registered checks contribute; the gate
  // keeps it matching. Edit inside the region below, which is the
  // repository's own: `fm check --fix` moves a setting added
  // anywhere else, VS Code's own included, into it.
  //
  // An editor terminal is an entered shell from its first prompt: the
  // profile evaluates the workspace's environment, then hands over to
  // the interactive shell, which inherits it. Per-user terminal
  // settings belong in the user's own settings, never here.
  // The repository's own settings, each line ending with a comma.
  // -- workshop: region settings, yours to edit; the render keeps it --
  // -- workshop: end settings --
  // What the registered checks and the listed extensions contribute.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "terminal.integrated.profiles.osx": {
    "livery": {
      "path": "zsh",
      "args": ["-c", "eval \"$(uv run -q fm --quiet env.emit posix)\"; exec zsh -i"]
    }
  },
  "terminal.integrated.defaultProfile.osx": "livery",
  "terminal.integrated.profiles.linux": {
    "livery": {
      "path": "bash",
      "args": ["-c", "eval \"$(uv run -q fm --quiet env.emit posix)\"; exec bash -i"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "livery",
  "terminal.integrated.profiles.windows": {
    "livery": {
      "path": "pwsh.exe",
      "args": ["-NoExit", "-Command", "uv run -q fm --quiet env.emit pwsh | Invoke-Expression"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "livery"
}
