# Seeded from the cpp-package template at
# birth; this file is the workspace's own. Edit it directly:
# nothing rewrites it.
cmake_minimum_required(VERSION 3.24)
project(tool CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# The program's code, in a library the program and its tests both link.
add_library(tool_core STATIC src/tool.cpp)
target_include_directories(tool_core PUBLIC src)

add_executable(tool src/main.cpp)
target_link_libraries(tool PRIVATE tool_core)

install(TARGETS tool)

enable_testing()
add_executable(test_tool tests/test_tool.cpp)
target_link_libraries(test_tool PRIVATE tool_core)
add_test(NAME test_tool COMMAND test_tool)
# The program itself is a test too: it starts and exits 0.
add_test(NAME tool COMMAND tool)
