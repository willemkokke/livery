"""The conan recipe for acme-dylib."""

from conan import ConanFile
from conan.tools.cmake import CMake, CMakeToolchain, cmake_layout


class DylibConan(ConanFile):
    """Build, test, and package the library through CMake."""

    name = "acme-dylib"
    version = "0.0.0"
    package_type = "shared-library"
    settings = "os", "compiler", "build_type", "arch"
    exports_sources = "CMakeLists.txt", "src/*", "tests/*"

    def layout(self):
        """Use conan's standard cmake layout under build/; headers live in src/.

        The source include directory is what a consumer sees while
        the workspace's conanws.yml resolves this package from its
        source, so it names src/ where the headers are, not conan's
        default include/.
        """
        cmake_layout(self)
        self.cpp.source.includedirs = ["src"]

    def generate(self):
        """Write the CMake toolchain file for the active profile."""
        CMakeToolchain(self).generate()

    def build(self):
        """Configure and build with CMake."""
        cmake = CMake(self)
        cmake.configure()
        cmake.build()

    def package(self):
        """Install the built targets into the conan package."""
        CMake(self).install()

    def package_info(self):
        """Name the built library for consumers; conan collects nothing on its own."""
        self.cpp_info.libs = ["dylib"]
