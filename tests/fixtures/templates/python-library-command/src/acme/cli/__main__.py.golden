"""The package's command line, the script its installation puts on PATH."""

from __future__ import annotations

import sys

from acme.cli import hello


def main(argv: list[str] | None = None) -> int:
    """Print the greeting and the words given; the exit code is the verdict.

    Args:
        argv: The words after the script's name; the process's own when None.

    Returns:
        The exit code, 0.
    """
    words = sys.argv[1:] if argv is None else argv
    print(" ".join([hello(), *words]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
