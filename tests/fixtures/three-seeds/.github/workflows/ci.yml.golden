# Generated by the workshop from workshop.toml; the gate keeps
# it matching. Edit the contract (or the emitters) and run
# `fm sync`; an edit here is drift.
name: ci

# A pull request, a push to main, and a dispatch by hand. A dispatched run
# pays the full gate: the check verb reads the event and narrows on a pull
# request alone, so every event spells the same call.
on:
  pull_request:
    types: [opened, synchronize, reopened, labeled]
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  # The check legs: each runs the gate, and its row rides its per-run ref
  # on the state store, in one write with the files its other entries
  # left, for the gate job. The scoped gate measures from the proved tree
  # nearest the checkout's, an earlier push's merge rebuilt from its two
  # commits among them, or from the merge base with the pull request's
  # base branch; each needs history a shallow clone lacks.
  check:
    permissions:
      contents: write
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest]
        python: ["3.14"]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          enable-cache: false
      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: ${{ runner.temp }}/footman/toolroom
          key: tools-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('toolroom.lock') }}
          restore-keys: tools-${{ runner.os }}-${{ runner.arch }}-
      - name: Enter the workspace
        env:
          UV_PYTHON: ${{ matrix.python }}
        run: bash setup.sh github
      - name: Check
        run: >-
          fm ci.run --point=gate --job=check
          --os="${{ matrix.os }}" --python="${{ matrix.python }}"
  # The one required context. Branch protection points here, so the matrix
  # can grow or shrink without touching repository settings. Its entries
  # run the judges the extensions add, collect the run's timing rows, ask
  # the forge for the jobs it needs, and stamp the tree a green run
  # proved; a red run is judged too. The stamp composes a narrowed run
  # with the record of the tree its legs measured from, and names the two
  # commits a merge checkout joined. On a push to main the same job then
  # dispatches the release wave, runs what the extensions add to the merge
  # point, and runs the janitor.
  gate:
    if: always()
    needs: [check]
    permissions:
      contents: write
      actions: write
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          enable-cache: false
      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: ${{ runner.temp }}/footman/toolroom
          key: tools-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('toolroom.lock') }}
          restore-keys: tools-${{ runner.os }}-${{ runner.arch }}-
      - name: Enter the workspace
        run: bash setup.sh github
      - name: Verdict
        env:
          FORGE_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: fm ci.run --point=gate --job=gate
  # The repository settings reconciled when the merge changed a contract
  # or the owners file. The commit's own file list decides whether
  # anything is governed; a depth of one would read a squash as a root.
  govern:
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 2
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          enable-cache: false
      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: ${{ runner.temp }}/footman/toolroom
          key: tools-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('toolroom.lock') }}
          restore-keys: tools-${{ runner.os }}-${{ runner.arch }}-
      - name: Enter the workspace
        run: bash setup.sh github
      - name: Govern
        env:
          FORGE_ADMIN_TOKEN: ${{ secrets.FORGE_ADMIN_TOKEN }}
        run: fm ci.run --point=merge --job=govern
