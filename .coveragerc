# Written by `fm sync` from the pytest extension while coverage is
# listed; the gate keeps it matching. Edit inside the region at the end,
# which is the repository's own; an edit anywhere else is drift.
[run]
# The tests measure, and every process they start, every
# fm child a test spawns included: inside CI the test
# runner arms COVERAGE_PROCESS_START in pytest's environment, the .pth
# coverage installs starts the meter in every python under it, and the
# patch cascades through the workers. The gate's own driver is never
# metered, so a line counts only when a test reached it. Each leg
# reduces its parallel data files to a part per suite, and the
# aggregating gate job merges every leg's parts.
patch = subprocess
parallel = true
# Each file is named from the workspace root, the names the legs' data
# and their parts carry; absolute names would differ by checkout.
relative_files = true
# Branches as well as statements: a conditional's untaken arm is
# uncovered, where line coverage shows the conditional as covered
# once its line ran. The floors judge the combined figure.
branch = true
source = livery
# A file under a test's temp directory is never a source. The tests
# keep a passing test's tmp_path only until its teardown, so a module a
# test wrote there and ran is gone when the report is written, and a
# report whose measured file is gone refuses.
omit = */pytest-of-*/*
# The C tracer, not sys.monitoring: the sysmon core records a line
# under the first context that reaches it and never again, and the
# check legs split one run's data per suite by context, which needs
# every context complete.
core = ctrace

[paths]
# One identity for a file whichever separator wrote it, so Windows
# and POSIX legs combine as one file set.
packages =
    packages/
    packages\

# The repository's own sections, a `[report]` or `[html]` say.
# -- workshop: region sections, yours to edit; the render keeps it --
# -- workshop: end sections --
