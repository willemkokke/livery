# Composed by `fm sync` from the lines each listed extension
# ships; the gate keeps it matching. Edit inside the region below,
# which is the repository's own; an edit anywhere else is drift.
dist/
.venv/
__pycache__/
fm-profile*.json
fm-gate.json
.claude/worktrees/
.workshop/
typings/
.repo.env.local
# The python build copies a package's docs into its source for the
# wheel, whole, on every build.
packages/**/src/**/_docs/
# Finder writes .DS_Store into any directory it opens; a workflow verb
# refuses a dirty tree, so the file is never a change.
.DS_Store
# The docs site's build and its generated pages.
site/
zensical.toml
.docs-build/
docs/packages/
docs/releases/
docs/tasks/
docs/tools/
docs/_generated/
docs/_extensions/
docs/development/
.docs-preview/
packages/**/docs/_generated/
packages/**/_generated/
# The data coverage.py's meter leaves where a test run is metered.
.coverage
.coverage.*
# The coverage pages drawn from the measured data; the parts and the
# union live under .workshop/, which the base ignores.
packages/**/htmlcov/
# -- workshop: region rules, yours to edit; the render keeps it --
# -- workshop: end rules --
