# Seeded from the cpp-package template at
# birth; this file is the workspace's own. Edit it directly:
# nothing rewrites it.
cmake_minimum_required(VERSION 3.24)
project({{ project_slug }} CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
{% if package_type == "header-library" %}
# A header-only library: an interface target that carries the include
# directory, and nothing to compile.
add_library({{ project_slug }} INTERFACE)
target_include_directories({{ project_slug }} INTERFACE src)

install(FILES src/{{ project_slug }}.hpp DESTINATION include)

enable_testing()
add_executable(test_{{ project_slug }} tests/test_{{ project_slug }}.cpp)
target_link_libraries(test_{{ project_slug }} PRIVATE {{ project_slug }})
add_test(NAME test_{{ project_slug }} COMMAND test_{{ project_slug }})
{%- elif package_type == "application" %}
# The program's code, in a library the program and its tests both link.
add_library({{ project_slug }}_core STATIC src/{{ project_slug }}.cpp)
target_include_directories({{ project_slug }}_core PUBLIC src)

add_executable({{ project_slug }} src/main.cpp)
target_link_libraries({{ project_slug }} PRIVATE {{ project_slug }}_core)

install(TARGETS {{ project_slug }})

enable_testing()
add_executable(test_{{ project_slug }} tests/test_{{ project_slug }}.cpp)
target_link_libraries(test_{{ project_slug }} PRIVATE {{ project_slug }}_core)
add_test(NAME test_{{ project_slug }} COMMAND test_{{ project_slug }})
# The program itself is a test too: it starts and exits 0.
add_test(NAME {{ project_slug }} COMMAND {{ project_slug }})
{%- else %}
{%- if package_type == "static-library" %}
add_library({{ project_slug }} STATIC src/{{ project_slug }}.cpp)
{%- elif package_type == "shared-library" %}
add_library({{ project_slug }} SHARED src/{{ project_slug }}.cpp)
{%- else %}
# Static or shared as BUILD_SHARED_LIBS says, which conan's shared
# option sets.
add_library({{ project_slug }} src/{{ project_slug }}.cpp)
{%- endif %}
target_include_directories({{ project_slug }} PUBLIC src)
{%- if package_type != "static-library" %}
# A Windows DLL exports only what is marked for export; this exports
# every symbol, so the header needs no export macro.
set_target_properties({{ project_slug }} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
{%- endif %}

install(TARGETS {{ project_slug }})
install(FILES src/{{ project_slug }}.hpp DESTINATION include)

enable_testing()
add_executable(test_{{ project_slug }} tests/test_{{ project_slug }}.cpp)
target_link_libraries(test_{{ project_slug }} PRIVATE {{ project_slug }})
add_test(NAME test_{{ project_slug }} COMMAND test_{{ project_slug }})
{%- endif %}
