// Shipped as livery.workshop layer content, delivered to the workspace
// by the sync verb. Edit this copy in the layer and release it;
// an edited delivered copy is a local override, kept and named.
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/fm-hook.sh ]; then bash .claude/hooks/fm-hook.sh pre-bash; else exit 0; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/fm-hook.sh ]; then bash .claude/hooks/fm-hook.sh post-edit; else exit 0; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/fm-hook.sh ]; then bash .claude/hooks/fm-hook.sh stop; else exit 0; fi"
          }
        ]
      }
    ]
  }
}
