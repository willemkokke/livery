{% set py = [] %}{% set native = [] %}{% for member in packages %}{% if member.dev is defined and member.dev %}{% set _ = py.append(member) %}{% else %}{% set _ = native.append(member) %}{% endif %}{% endfor -%}
# Rendered by the template channel ({{ template_source_label }}, project kind);
# the gate keeps it matching its render. Edit the source and
# run `{{ runner_prog }} template.apply`; an edit here is drift.
# The workspace's virtual root: never built, never published.
[project]
name = "{{ project_name }}"
version = "0.0.1"
description = "{{ project_description }}"
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">={{ python_floor }}"
{% if author_email %}authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
{% endif %}classifiers = [
    "Development Status :: 1 - Planning",
    "Programming Language :: Python :: 3",
]

[tool.uv]
package = false
default-groups = ["dev", "docs"]
{% if python_prerelease %}prerelease = "{{ python_prerelease }}"
{% endif %}{% if python_registry %}
# The contract's python registry: reads resolve here first, the
# ecosystem default fills the rest. Declared in workshop.toml
# [registries]; this render carries it, so edit the contract there.
[[tool.uv.index]]
name = "workshop"
url = "{{ python_registry }}"
{% endif %}
[tool.uv.workspace]
# The members, explicitly: the roster lives in the answers and this
# file is rendered from it, so a glob would only re-derive the same
# list while letting a stray directory join unnoticed. A non-python
# member (a cpp-conan package) is no uv project and never appears.
members = [{% for package in py %}"packages/{{ package.dir }}"{% if not loop.last %}, {% endif %}{% endfor %}]

[tool.uv.sources]
{% for package in py %}{{ package.name }} = { workspace = true }
{% endfor %}
[dependency-groups]
# The docs toolchain, workshop-rendered so one layer release moves
# every project's generator together.
docs = [
    "zensical>=0.0.50",
    "mkdocstrings-python>=1.11",
]
dev = [
    # uv itself, unconstrained so it tracks latest; the lockfile still
    # resolves it to one exact version (footman's lockfile-churn lesson).
    "uv",
    # Typed tool handles tasks.py runs through.
{% if 'livery-footman' not in py | map(attribute='name') | list %}    "livery-footman>=0.52.2",
{% endif %}{% if 'livery-toolroom' not in py | map(attribute='name') | list %}    "livery-toolroom>=0.6.2",
{% endif %}    # The workspace members, so root tests import them; an entry may
    # carry extras the dev loop needs.
{% for package in py %}    "{{ package.dev }}",
{% endfor %}    # Every contract layer that is not already a member above, so a
    # rendered tasks.py can always import its plugins.
{% for requirement in layer_requirements %}    "{{ requirement }}",
{% endfor %}{% if packages | selectattr('kind', 'defined') | selectattr('kind', 'equalto', 'python-nanobind') | list %}    # An extension member's editor configure asks this interpreter
    # where nanobind's cmake directory is, so the venv carries it
    # beside the build's own isolated copy.
    "nanobind>=2.7",
{% endif %}    # What the registered checks need in the venv: each line is a
    # check record's contribution to the `python.dev-group` slot, so a
    # check a layer withdraws takes its line with it, and the record
    # is where its floor and its reason live.
{% for requirement in slots['python.dev-group'] %}    "{{ requirement }}",
{% endfor %}]

{% if docs_site_url %}[tool.footman]
# Task names in --list/--tree/--help (and --json rows) link into the
# published task reference; the alias tree there redirects each task
# to its page in the owning package's section.
docs-url = "{{ docs_site_url }}tasks/{slug}/"

{% endif %}# The tables the registered checks own, each a check record's
# fragment for this file, composed in check-name order; a check a
# layer withdraws takes its tables with it.
{{ fragments['pyproject.toml'] }}
[tool.footman.notes]
# Every misuse note fails the task at its boundary: a raw spawn or
# an ambient write is fixed or deliberately classified, never
# ambient. Loosen a single kind here with a reason, never the star.
"*" = "error"

# The repository's own tables: whole tables and array-of-table entries
# (a `[[tool.basedpyright.executionEnvironments]]` for an imported
# suite, a `[tool.x]` of your own), never a key inside a table the
# render wrote; a tool with an `extend-` spelling takes that.
# -- workshop: region tables, yours to edit; the render keeps it --
{{ (regions.get('pyproject.toml') or {}).get('tables', '') }}# -- workshop: end tables --
