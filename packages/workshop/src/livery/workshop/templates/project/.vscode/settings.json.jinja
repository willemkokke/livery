{
  // Rendered by the template channel ({{ template_source_label }}, project kind);
  // the gate keeps it matching its render. Edit the source and
  // run `{{ runner_prog }} template.apply`; an edit here is drift.
  //
  // An editor terminal is an entered shell from its first prompt: the
  // profile evaluates the workspace's environment, then hands over to
  // the interactive shell, which inherits it. Per-user terminal
  // settings belong in the user's own settings, never here.
  "terminal.integrated.profiles.osx": {
    "{{ project_name }}": {
      "path": "zsh",
      "args": ["-c", "eval \"$(uv run -q {{ runner_prog }} --quiet env.emit posix)\"; exec zsh -i"]
    }
  },
  "terminal.integrated.defaultProfile.osx": "{{ project_name }}",
  "terminal.integrated.profiles.linux": {
    "{{ project_name }}": {
      "path": "bash",
      "args": ["-c", "eval \"$(uv run -q {{ runner_prog }} --quiet env.emit posix)\"; exec bash -i"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "{{ project_name }}",
  "terminal.integrated.profiles.windows": {
    "{{ project_name }}": {
      "path": "pwsh.exe",
      "args": ["-NoExit", "-Command", "uv run -q {{ runner_prog }} --quiet env.emit pwsh | Invoke-Expression"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "{{ project_name }}"
}
