# Seeded from the python-cli template at
# birth; this file is the workspace's own. Edit it directly:
# nothing rewrites it.
[build-system]
requires = ["uv_build>=0.11,<0.13"]
build-backend = "uv_build"

[project]
name = "acme-cli"
version = "0.0.0"
description = "acme-cli: a package of the acme workspace."
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">=3.11"
authors = [{ name = "A", email = "a@example.com" }]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Environment :: Console",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Typing :: Typed",
]

# The command line: installing the package puts cli on PATH,
# and `fm run` starts it from the workspace's environment.
[project.scripts]
cli = "acme.cli.__main__:main"

[project.urls]
Repository = "https://github.com/acme/acme"

[tool.uv.build-backend]
# PEP 420 namespace: the importable package is acme.cli and
# there is no acme/__init__.py anywhere in this repository.
module-name = "acme.cli"
