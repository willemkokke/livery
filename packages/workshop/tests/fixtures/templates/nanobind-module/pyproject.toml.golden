# Seeded from the nanobind-module template at
# birth; this file is the workspace's own. Edit it directly:
# nothing rewrites it.
[build-system]
requires = ["scikit-build-core>=0.11", "nanobind>=2.7"]
build-backend = "scikit_build_core.build"

[project]
name = "acme-native"
version = "0.0.0"
description = "acme-native: a package of the acme workspace."
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">=3.11"
authors = [{ name = "A", email = "a@example.com" }]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Typing :: Typed",
]

[project.urls]
Repository = "https://github.com/acme/acme"

[tool.uv]
# What decides whether uv rebuilds the extension: the git commit, not
# the modification times uv tracks by default (pyproject.toml and the
# src directory). A fresh checkout writes every file with a new time,
# so a CI job rebuilt the member on every run; keyed on the commit, a
# checkout at the same commit reuses the build the cache holds, and a
# new commit rebuilds. On a desk an uncommitted edit under src or to
# this file does not rebuild until it is committed; an edit to an
# existing source file never did through uv, the build rig compiles it.
cache-keys = [{ git = { commit = true } }]

[tool.scikit-build]
# The compiled module builds through CMake and lands inside the
# package; the pure-python sources ride from src/ unchanged.
minimum-version = "build-system.requires"
build-dir = "build/{wheel_tag}"
wheel.packages = ["src/acme"]

[tool.scikit-build.cmake.define]
# The CMake dependency provider that resolves find_package through
# conan: the store names the file in CMAKE_CONAN_PROVIDER when the
# environment is entered, and CMake reads no environment variable of
# its own for this.
CMAKE_PROJECT_TOP_LEVEL_INCLUDES = { env = "CMAKE_CONAN_PROVIDER" }
# What conan builds for the provider: a package the cache lacks, and a
# workspace sibling, from its source at HEAD through the workspace's
# conanws.yml. A release leg sets the workspace aside, so there the
# second is a no-op.
# Those builds use Ninja on every host, the store's generator, under
# the compiler environment conan activates; a Visual Studio generator
# would let MSBuild pick a platform apart from the compiler conan names.
# The environment wins where it is set: the floor leg builds the same
# package against the version the contract floors a sibling at, by
# passing these arguments and a profile that replaces the sibling's
# requirement with that version.
CONAN_INSTALL_ARGS = { env = "CONAN_INSTALL_ARGS", default = "--build=missing;--build=editable;-c;tools.cmake.cmaketoolchain:generator=Ninja" }
