# Seeded from the package-python seeds at
# birth; this file is the workspace's own. Edit it directly:
# nothing rewrites it.
[build-system]
requires = ["uv_build>=0.11,<0.13"]
build-backend = "uv_build"

[project]
name = "acme-echo"
version = "0.0.0"
description = "acme-echo: a acme workspace package."
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">=3.11"
authors = [{ name = "A", email = "a@example.com" }]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Typing :: Typed",
]

[project.urls]
Repository = "https://github.com/acme/acme"

[tool.uv.build-backend]
# PEP 420 namespace: the importable package is acme.echo and
# there is no acme/__init__.py anywhere in this repository.
module-name = "acme.echo"
