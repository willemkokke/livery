"""The plugin App: the workshop, branded.

Installing this extension's wheel puts ``plugin`` on PATH:
the whole workshop surface plus this extension's own verbs, under this
extension's name. The birth verb it carries creates children whose
default extension stack is this App's own, which is how a home begets.
"""

from __future__ import annotations

import sys

from livery.footman import App


def main() -> int:
    """Run the branded App; the exit code is the verdict."""
    return App(
        name="plugin",
        prog="plugin",
        dist="acme-plugin",
        builtin=["livery.workshop", "acme.plugin"],
    ).run(sys.argv[1:])
