# Seeded from the package-extension seeds at
# birth; this file is the workspace's own. Edit it directly:
# nothing rewrites it.
[project.entry-points."footman.tasks"]
"acme.plugin" = "acme.plugin._tasks"

# The workshop extension this package is, by the name a workspace
# lists: the package beside its extension.toml.
[project.entry-points."workshop.extensions"]
"acme.plugin" = "acme.plugin"

# The branded App: the workshop surface under this extension's name.
[project.scripts]
plugin = "acme.plugin._app:main"

[build-system]
requires = ["uv_build>=0.11,<0.13"]
build-backend = "uv_build"

[project]
name = "acme-plugin"
version = "0.0.0"
description = "acme-plugin: a acme workspace package."
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">=3.11"
authors = [{ name = "A", email = "a@example.com" }]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Typing :: Typed",
]
# An extension is the workshop, extended: its plugin and its App stand on
# the base extension's wheel, and its App imports the runner, footman.
dependencies = ["livery-workshop", "livery-footman"]

[project.urls]
Repository = "https://github.com/acme/acme"

[tool.uv.build-backend]
# PEP 420 namespace: the importable package is acme.plugin and
# there is no acme/__init__.py anywhere in this repository.
module-name = "acme.plugin"
