# Written by `{{ prog }} sync` from the pyrefly extension; the gate keeps
# it matching. Edit inside the region at the end, which is the
# repository's own; an edit anywhere else is drift.
#
# The packages themselves. Preset `default`, not `strict`: strict
# demands @override, and `typing.override` is Python 3.12+; a library
# that supports 3.11 cannot spell it without the typing_extensions
# backport as a runtime dependency.
preset = "default"
project-includes = [{% if py %}{% for package in py %}"packages/{{ package.dir }}/src"{% if not loop.last %}, {% endif %}{% endfor %}{% else %}"tasks.py"{% endif %}]
# Both path heuristics off: a checkout under a dot-directory (a
# `.claude/worktrees/` worktree) silently skips every include, and the
# check fails on "no files matched". At the root neither setting
# changes anything.
use-ignore-files = false
disable-project-excludes-heuristics = true
# The tool stubs `{{ runner_prog }} toolroom.restub` writes.
search-path = ["typings"]
# Every platform at once, {{ python_floor }} floor.
python-platform = "all"
python-version = "{{ python_floor }}"

[errors]
# Held at error so they cannot accumulate unnoticed.
deprecated = "error"
unnecessary-type-conversion = "error"

# The repository's own tables.
# -- workshop: region tables, yours to edit; the render keeps it --
# -- workshop: end tables --
