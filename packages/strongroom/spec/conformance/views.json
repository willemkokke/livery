{
  "scenarios": [
    {
      "id": "a-view-round-trips-through-collect",
      "namespaces": [],
      "steps": [
        {"op": "put", "data": "read me", "as": "R"},
        {"op": "put", "data": "main", "as": "M"},
        {"op": "tree", "entries": {"main.py": "M"}, "as": "SRC"},
        {"op": "tree", "entries": {"README.md": "R"}, "subtrees": {"src": "SRC"}, "links": {"latest": "src/main.py"}, "as": "T"},
        {"op": "view", "tree": "T", "at": "v", "as": "V"},
        {"op": "entry", "view": "V", "path": "README.md", "expect_rung": ["clone", "hardlink", "link", "copy"]},
        {"op": "entry", "view": "V", "path": "latest", "expect_rung": ["symlink", "copy"]},
        {"op": "collect", "at": "v", "declared": ["README.md", "src", "latest"], "expect": "T"},
        {"op": "drop-view", "view": "V", "expect_left": []},
        {"op": "sweep", "expect_removed": ["T", "SRC", "R", "M"]}
      ]
    },
    {
      "id": "an-executable-entry-round-trips-and-a-declared-output-is-executable",
      "namespaces": [],
      "steps": [
        {"op": "put", "data": "#!/bin/sh\n", "as": "S"},
        {"op": "put", "data": "not the view's", "as": "N"},
        {"op": "tree", "entries": {"run.sh": "S"}, "executable": ["run.sh"], "as": "T"},
        {"op": "view", "tree": "T", "at": "v", "as": "V"},
        {"op": "collect", "at": "v", "declared": ["run.sh"], "expect": "T"},
        {"op": "stray", "at": "v", "path": "made.sh"},
        {"op": "tree", "entries": {"run.sh": "S", "made.sh": "N"}, "executable": ["run.sh"], "as": "T2"},
        {"op": "collect", "at": "v", "declared": ["run.sh", "made.sh"], "expect": "T2"},
        {"op": "tree", "entries": {"run.sh": "S", "made.sh": "N"}, "executable": ["run.sh", "made.sh"], "as": "T3"},
        {"op": "collect", "at": "v", "declared": ["run.sh", "made.sh"], "executable": ["made.sh"], "expect": "T3"}
      ]
    },
    {
      "id": "a-live-view-is-a-root",
      "namespaces": [],
      "steps": [
        {"op": "put", "data": "a", "as": "A"},
        {"op": "tree", "entries": {"a": "A"}, "as": "T"},
        {"op": "view", "tree": "T", "at": "v", "as": "V"},
        {"op": "sweep", "expect_removed": []},
        {"op": "drop-view", "view": "V", "expect_left": []},
        {"op": "sweep", "expect_removed": ["T", "A"]}
      ]
    },
    {
      "id": "drop-leaves-what-it-did-not-create",
      "namespaces": [],
      "steps": [
        {"op": "put", "data": "a", "as": "A"},
        {"op": "tree", "entries": {"a": "A"}, "as": "SUB"},
        {"op": "tree", "entries": {}, "subtrees": {"sub": "SUB"}, "as": "T"},
        {"op": "view", "tree": "T", "at": "v", "as": "V"},
        {"op": "stray", "at": "v", "path": "sub/mine.txt"},
        {"op": "drop-view", "view": "V", "expect_left": ["sub: not created by the view: mine.txt", ".: not created by the view: sub"]},
        {"op": "exists", "at": "v", "path": "sub/mine.txt", "expect": true},
        {"op": "exists", "at": "v", "path": "sub/a", "expect": false}
      ]
    },
    {
      "id": "an-escaping-symlink-is-parked-when-links-are-refused",
      "namespaces": [],
      "steps": [
        {"op": "put", "data": "a", "as": "A"},
        {"op": "tree", "entries": {"a": "A"}, "links": {"out": "../elsewhere", "in": "a"}, "as": "T"},
        {"op": "refuse-symlinks"},
        {"op": "view", "tree": "T", "at": "v", "as": "V"},
        {"op": "entry", "view": "V", "path": "out", "expect_rung": ["parked"]},
        {"op": "entry", "view": "V", "path": "in", "expect_rung": ["copy"]},
        {"op": "exists", "at": "v", "path": "out", "expect": false},
        {"op": "exists", "at": "v", "path": "in", "expect": true}
      ]
    },
    {
      "id": "an-escaping-symlink-is-parked-on-every-platform",
      "namespaces": [],
      "steps": [
        {"op": "put", "data": "a", "as": "A"},
        {"op": "tree", "entries": {"a": "A"}, "links": {"out": "../elsewhere", "in": "a"}, "as": "T"},
        {"op": "view", "tree": "T", "at": "v", "as": "V"},
        {"op": "entry", "view": "V", "path": "out", "expect_rung": ["parked"]},
        {"op": "entry", "view": "V", "path": "in", "expect_rung": ["symlink", "copy"]},
        {"op": "exists", "at": "v", "path": "out", "expect": false},
        {"op": "exists", "at": "v", "path": "in", "expect": true},
        {"op": "drop-view", "view": "V", "expect_left": []}
      ]
    },
    {
      "id": "an-erased-entry-fails-the-view-loudly",
      "namespaces": [{"name": "urls", "mutation": "volatile"}],
      "steps": [
        {"op": "put", "data": "a face", "as": "F"},
        {"op": "tree", "entries": {"face": "F"}, "as": "T"},
        {"op": "set", "namespace": "urls", "path": "keep", "digest": "T", "previous": null, "expect": "ok"},
        {"op": "erase", "digest": "F", "reason": "erasure request"},
        {"op": "view", "tree": "T", "at": "v", "as": "V", "expect": "erased"},
        {"op": "exists", "at": "v", "path": "face", "expect": false}
      ]
    }
  ]
}
