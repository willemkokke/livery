"2277 lines: _release, _publish, _cliff, _dev_release, _replay, _wheels, _registries"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="758" y="52" width="177" height="100" as="geometry"/></mxCell></object><object id="s_delivery" label="&lt;b&gt;Content delivery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;templates, sync, prose, materialise, provenance, fragments&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;4,524 lines&lt;/font&gt;" subsystem="delivery" modules="_templates _sync _materialise _prose _fragments _regions _provenance _entry _update" lines="4524" tooltip="4524 lines: _templates, _sync, _materialise, _prose, _fragments, _regions, _provenance, _entry, _update"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="945" y="52" width="177" height="100" as="geometry"/></mxCell></object><object id="s_env" label="&lt;b&gt;Environment and tools&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;env cascade, venv reconcile, shell, devenv, tool lock&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;4,519 lines&lt;/font&gt;" subsystem="env" modules="_env_tasks _envfile _reconcile _shell _devenv _tools _tool_tasks _uv" lines="4519" tooltip="4519 lines: _env_tasks, _envfile, _reconcile, _shell, _devenv, _tools, _tool_tasks, _uv"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="1132" y="52" width="177" height="100" as="geometry"/></mxCell></object><object id="s_docs" label="&lt;b&gt;Docs site&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;site config, API pages, llms.txt, task reference&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;2,671 lines&lt;/font&gt;" subsystem="docs" modules="_docs _llms _taskref" lines="2671" tooltip="2671 lines: _docs, _llms, _taskref"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="1319" y="52" width="177" height="100" as="geometry"/></mxCell></object><object id="s_birth" label="&lt;b&gt;Birth and loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;new.project; ci.e2e against a local forge&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;3,205 lines&lt;/font&gt;" subsystem="birth" modules="_new_project _e2e" lines="3205" tooltip="3205 lines: _new_project, _e2e"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="1506" y="52" width="177" height="100" as="geometry"/></mxCell></object><object id="rowB" label="&lt;b&gt;Foundation&lt;/b&gt;"><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="core"><mxGeometry x="10" y="170" width="400" height="20" as="geometry"/></mxCell></object><object id="s_model" label="&lt;b&gt;Workspace model&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;contracts, package discovery, affected graph, categories, layering lint&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;2,055 lines&lt;/font&gt;" subsystem="model" modules="_contract _packages _graph _categories _ast_rules _governance _pythons __init__" lines="2055" tooltip="2055 lines: _contract, _packages, _graph, _categories, _ast_rules, _governance, _pythons, __init__"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="10" y="192" width="326" height="70" as="geometry"/></mxCell></object><object id="s_mount" label="&lt;b&gt;Layer mount&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the layer walk, template overlay composition&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;806 lines&lt;/font&gt;" subsystem="mount" modules="_layers _compose" lines="806" tooltip="806 lines: _layers, _compose"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="346" y="192" width="326" height="70" as="geometry"/></mxCell></object><object id="s_registry" label="&lt;b&gt;Registries&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;kinds, checks, slots&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;2,035 lines&lt;/font&gt;" subsystem="registry" modules="_kinds _checks _slots _backends" lines="2035" tooltip="2035 lines: _kinds, _checks, _slots, _backends"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="682" y="192" width="326" height="70" as="geometry"/></mxCell></object><object id="s_state" label="&lt;b&gt;State store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;JSON rows on git refs; the declared series&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;1,839 lines&lt;/font&gt;" subsystem="state" modules="_state _series _store_tasks" lines="1839" tooltip="1839 lines: _state, _series, _store_tasks"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="1018" y="192" width="326" height="70" as="geometry"/></mxCell></object><object id="s_root" label="&lt;b&gt;Verb wiring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;_tasks mounts every verb; agent hooks&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;338 lines&lt;/font&gt;" subsystem="root" modules="_tasks _tree _hooks" lines="338" tooltip="338 lines: _tasks, _tree, _hooks"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="core"><mxGeometry x="1354" y="192" width="326" height="70" as="geometry"/></mxCell></object><object id="lang" label="Language-specific code inside the core"><mxCell style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;container=1;collapsible=0;fontFamily=Helvetica;fillColor=#fff5f5;strokeColor=#b85450;fontColor=#b85450;fontSize=12;" vertex="1" parent="core"><mxGeometry x="10" y="280" width="1680" height="270" as="geometry"/></mxCell></object><object id="bk0" label="&lt;b&gt;python backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;run_format/lint/typecheck/test, coverage combine, API extractor, examples&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;2,258 lines&lt;/font&gt;" modules="_backends._python" lines="2258"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lang"><mxGeometry x="10" y="30" width="220" height="95" as="geometry"/></mxCell></object><object id="bk1" label="&lt;b&gt;cpp-conan backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;configure, compile, ctest, clang-format/tidy, ConanRegistry&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;1,509 lines&lt;/font&gt;" modules="_backends._cpp_conan" lines="1509"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lang"><mxGeometry x="240" y="30" width="220" height="95" as="geometry"/></mxCell></object><object id="bk2" label="&lt;b&gt;python-nanobind backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;composes the two above; platform wheels, floor legs&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;422 lines&lt;/font&gt;" modules="_backends._python_nanobind" lines="422"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lang"><mxGeometry x="470" y="30" width="220" height="95" as="geometry"/></mxCell></object><object id="s_pytest" label="&lt;b&gt;pytest plugins&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;isolation, points, contexts, examples, speed&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666'&gt;777 lines&lt;/font&gt;" subsystem="pytest" modules="_pytest_console _pytest_contexts _pytest_examples _pytest_isolation _pytest_layout _pytest_points _pytest_speed" lines="777" tooltip="777 lines: _pytest_console, _pytest_contexts, _pytest_examples, _pytest_isolation, _pytest_layout, _pytest_points, _pytest_speed"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lang"><mxGeometry x="700" y="30" width="200" height="95" as="geometry"/></mxCell></object><object id="bypass" label="&lt;b&gt;Direct imports of a backend, past the registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;_checks (builtin checks call _python.run_* and _cpp_conan.*), _quality (verbs call _python directly), _docs (_python._unmetered, stored_union), _release (cpp_conan cache, nanobind floor legs), _release_driver (run_isolated_test, ConanRegistry), _e2e (ConanRegistry)&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lang"><mxGeometry x="920" y="30" width="750" height="95" as="geometry"/></mxCell></object><object id="defaults" label="&lt;b&gt;Python and conan assumed by name in about 25 core modules&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;KindRecord defaults artifact=&amp;quot;python&amp;quot;, wheel_identity=&amp;quot;pure&amp;quot;. Branches on artifact == &amp;quot;conan&amp;quot;, *.whl, pyproject.toml, uv publish, PyPI URLs, cibuildwheel: _release, _release_driver, _dev_release, _publish, _registries, _packages, _templates, _sync, _update, _wheels, _points, _ci_generate, _e2e, _replay, _taskref, _fragments, _checks. Separate from these: the workshop's own runtime is a uv venv (_reconcile, _env_tasks, _entry, _uv), which is python by design.&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lang"><mxGeometry x="10" y="140" width="1660" height="115" as="geometry"/></mxCell></object><object id="pk" label="Packages the workshop stands on (dependencies point down)"><mxCell style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;container=1;collapsible=0;fontFamily=Helvetica;fillColor=#eef3fb;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="1220" width="1700" height="130" as="geometry"/></mxCell></object><object id="pk_footman" label="&lt;b&gt;livery.footman&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;task runner and fm: typed tasks, plugin(), hooks, env, attended(); hands off to the workspace venv. No livery deps.&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pk"><mxGeometry x="10" y="30" width="270" height="90" as="geometry"/></mxCell></object><object id="pk_forge" label="&lt;b&gt;livery.forge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one interface to GitHub, Gitea, GitLab: frozen protocols, supports(capability), Unsupported, FakeForge, conformance. stdlib only.&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pk"><mxGeometry x="291" y="30" width="270" height="90" as="geometry"/></mxCell></object><object id="pk_toolroom" label="&lt;b&gt;livery.toolroom&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;typed tool handles: kwargs to flags; routes through footman when a context is live. No livery deps.&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pk"><mxGeometry x="572" y="30" width="270" height="90" as="geometry"/></mxCell></object><object id="pk_store" label="&lt;b&gt;livery.toolroom.store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the pinned tool store: records, lock, catalogue, stubs. Over strongroom.&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pk"><mxGeometry x="853" y="30" width="270" height="90" as="geometry"/></mxCell></object><object id="pk_strongroom" label="&lt;b&gt;livery.strongroom&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;content-addressed storage: digests, trees, refs, views.&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pk"><mxGeometry x="1134" y="30" width="270" height="90" as="geometry"/></mxCell></object><object id="pk_cbor" label="&lt;b&gt;livery.cbor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;deterministic CBOR. No consumer in the repo.&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=none;strokeColor=#999999;dashed=1;fontColor=#777777;" vertex="1" parent="pk"><mxGeometry x="1415" y="30" width="270" height="90" as="geometry"/></mxCell></object><object id="e_forge_ep" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="lay_forge" target="ep0_1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="e_bench_ep" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="lay_bench" target="ep0_1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="e_footman_ep" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="lay_footman" target="ep0_1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="e_bench_point" label="tool-hosts"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="lay_bench" target="ep3_0"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="e_bench_up" label="imports private _docs.write_nav_block"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="lay_bench" target="s_docs"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="e_lane" label="_forge_lane picks the backend by name"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="s_forgeflow" target="pk_forge"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="findings" label="&lt;b style='font-size:14px'&gt;Findings&lt;/b&gt;&lt;ol&gt;&lt;li style='margin-bottom:6px'&gt;Every registry exists, but no layer outside the workshop registers anything. The kinds, checks, slots and categories are all builtins registered from inside the core.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;The registries live in underscore modules. By the rule that public is __all__, a third-party layer has no supported way to call register_kind or register_check.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;8 core modules import a concrete backend directly, and about 25 branch on python, conan or wheels by name. Adding a language today means editing the core.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;_update.bump_floors reads pyproject.toml for every package: by reading the code, it raises on a cpp-conan member.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;python-nanobind gets no configure, build, ctest or clang-tidy check: those records list cpp-conan only.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;The forge boundary is clean (protocols plus supports()), but _forge_lane dispatches github/gitea/gitlab by name: a fourth forge edits the workshop.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;Three registries are static lists a layer cannot extend: _series, _registries (python/conan/container), the builtin CI points.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;livery.toolroom.bench, a layer, imports the private livery.workshop._docs.write_nav_block; the public rewrite_nav_block exists.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;26 pairs of core subsystems import each other at runtime, most through imports inside functions. See the Dependencies page.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;The [verbs] table in two package contracts has no reader.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;Where mount_layers() runs: the code says tasks.py calls it, the layer docs say importing the plugin does.&lt;/li&gt;&lt;li style='margin-bottom:6px'&gt;content/settings.json is copied per layer, so the last layer's copy wins; each layer's pass rewrites the shared materialised manifest. Moot while only the workshop ships content.&lt;/li&gt;&lt;/ol&gt;"><mxCell style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1740" y="70" width="460" height="1280" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="dsm" name="Dependencies"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="dtitle" label="&lt;b style='font-size:20px'&gt;Subsystem dependency matrix&lt;/b&gt;&lt;br&gt;Row imports column. Rows are ordered from foundation (top) to verbs (bottom), so a clean layering puts every number below the diagonal. Orange: an upward dependency. Red border: the two subsystems import each other at runtime. Number: module-level imports / imports inside functions. Type-only imports are left out."><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1300" height="70" as="geometry"/></mxCell></object><object id="col_state" label="State store"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_state" label="&lt;b&gt;State store&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="190" width="180" height="62" as="geometry"/></mxCell></object><object id="col_model" label="Workspace model"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="252" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_model" label="&lt;b&gt;Workspace model&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="252" width="180" height="62" as="geometry"/></mxCell></object><object id="col_mount" label="Layer mount"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="314" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_mount" label="&lt;b&gt;Layer mount&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="314" width="180" height="62" as="geometry"/></mxCell></object><object id="col_registry" label="Registries"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="376" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_registry" label="&lt;b&gt;Registries&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="376" width="180" height="62" as="geometry"/></mxCell></object><object id="col_backends" label="Kind backends"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="438" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_backends" label="&lt;b&gt;Kind backends&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="438" width="180" height="62" as="geometry"/></mxCell></object><object id="col_env" label="Environment and tools"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_env" label="&lt;b&gt;Environment and tools&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="180" height="62" as="geometry"/></mxCell></object><object id="col_delivery" label="Content delivery"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="562" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_delivery" label="&lt;b&gt;Content delivery&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="562" width="180" height="62" as="geometry"/></mxCell></object><object id="col_gate" label="Quality gate"><mxCell style="text;html=1;rotation=-60;align=left;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="624" y="80" width="62" height="105" as="geometry"/></mxCell></object><object id="row_gate" label="&lt;b&gt;Quality gate&lt;/b&gt;"><mxCell style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="624" width="180" height="62" as="geometry"/></mxCell></object><object id="col_forgeflow" label="Issues and submit"><mxCell style="text;html=1;rotation=-60;align=left;verticalA