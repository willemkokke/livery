 id="m_root_backends" label="" frm="root" to="backends"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="438" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_env" label="4/0" frm="root" to="env"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="500" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_delivery" label="4/0" frm="root" to="delivery"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="562" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_gate" label="3/2" frm="root" to="gate"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="624" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_forgeflow" label="3/0" frm="root" to="forgeflow"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="686" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_ci" label="1/0" frm="root" to="ci"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="748" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_engine" label="3/0" frm="root" to="engine"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="810" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_release" label="1/0" frm="root" to="release"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="872" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_docs" label="1/0" frm="root" to="docs"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="934" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_birth" label="2/0" frm="root" to="birth"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="996" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_pytest" label="" frm="root" to="pytest"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1058" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="m_root_root" label="" frm="root" to="root"><mxCell style="whiteSpace=wrap;html=1;fontSize=10;strokeColor=#dddddd;fontFamily=Helvetica;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="1120" y="1120" width="62" height="62" as="geometry"/></mxCell></object><object id="dnote" label="33 upward cells, 26 runtime cycles between pairs (verb wiring excluded: it imports every verb on purpose)."><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="1202" width="1100" height="30" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="workflow" name="Workflow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="wtitle" label="&lt;b style='font-size:20px'&gt;The codified workflow&lt;/b&gt;&lt;br&gt;What a developer runs, and the forge capability each step uses. Every step is an fm verb; re-running a verb is its recovery."><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="50" as="geometry"/></mxCell></object><object id="w0" label="&lt;b&gt;fm start&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;file or pick an issue; worktree under the runner's data dir; branch kind/number-slug&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="80" width="300" height="100" as="geometry"/></mxCell></object><object id="wf0" label="&lt;font style='font-size:10px'&gt;forge: Issues&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="185" width="300" height="30" as="geometry"/></mxCell></object><object id="w1" label="&lt;b&gt;fm check --fix&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the gate: rewriters then judges in parallel; proves the tree and records it&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="80" width="300" height="100" as="geometry"/></mxCell></object><object id="wf1" label="&lt;font style='font-size:10px'&gt;forge: none: local only&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="185" width="300" height="30" as="geometry"/></mxCell></object><object id="we1" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="w0" target="w1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="w2" label="&lt;b&gt;fm commit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;conventional commit on a proved tree&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="300" height="100" as="geometry"/></mxCell></object><object id="wf2" label="&lt;font style='font-size:10px'&gt;forge: none&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="185" width="300" height="30" as="geometry"/></mxCell></object><object id="we2" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="w3" label="&lt;b&gt;fm submit --armed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;local gate, push, open or find the PR, arm auto-merge, follow the verdict (exit codes 10 to 17)&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="80" width="300" height="100" as="geometry"/></mxCell></object><object id="wf3" label="&lt;font style='font-size:10px'&gt;forge: PullRequests, Checks, auto_merge&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="185" width="300" height="30" as="geometry"/></mxCell></object><object id="we3" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="w4" label="&lt;b&gt;gate point&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CI runs the same fm check, scoped to affected packages&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="280" width="300" height="100" as="geometry"/></mxCell></object><object id="wf4" label="&lt;font style='font-size:10px'&gt;forge: Checks&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="385" width="300" height="30" as="geometry"/></mxCell></object><object id="we4" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="w3" target="w4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="w5" label="&lt;b&gt;merge point&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;main after the merge; the worktree is swept&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="280" width="300" height="100" as="geometry"/></mxCell></object><object id="wf5" label="&lt;font style='font-size:10px'&gt;forge: Checks, Schedules&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="385" width="300" height="30" as="geometry"/></mxCell></object><object id="we5" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="w4" target="w5"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="w6" label="&lt;b&gt;fm workflow.release&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reserved branch workflow/release: prepare, submit, publish, tag&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="300" height="100" as="geometry"/></mxCell></object><object id="wf6" label="&lt;font style='font-size:10px'&gt;forge: PullRequests, Releases, Registry&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="385" width="300" height="30" as="geometry"/></mxCell></object><object id="we6" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="w5" target="w6"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="w7" label="&lt;b&gt;nightly point&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;scheduled tasks: tools.refresh, tool-hosts, workflow.update&lt;/font&gt;"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;spacingTop=4;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="280" width="300" height="100" as="geometry"/></mxCell></object><object id="wf7" label="&lt;font style='font-size:10px'&gt;forge: Schedules, pipeline_schedules&lt;/font&gt;"><mxCell style="text;html=1;align=left;fontColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="385" width="300" height="30" as="geometry"/></mxCell></object><object id="we7" label=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="w6" target="w7"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="wnote" label="Draft from what the verbs' docstrings say; the order and the capability labels are the parts to check."><mxCell style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="1100" height="30" as="geometry"/></mxCell></object></root></mxGraphModel></diagram></mxfile>
