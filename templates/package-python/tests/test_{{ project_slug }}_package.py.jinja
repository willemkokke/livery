"""The package imports, carries its version, and pins its surface."""

from __future__ import annotations

import {{ import_path }} as package


def test_imports_and_carries_a_version() -> None:
    assert package.__version__ == "0.0.1"
    assert package.hello() == "hello from {{ package_name }}"


def test_the_public_surface_is_pinned() -> None:
    assert set(package.__all__) == {"__version__", "hello"}
