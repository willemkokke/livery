# The gate and the train, GitLab-shaped. One pipeline definition:
# workflow rules admit merge requests, main, release tags, and
# LIVERY_WORKFLOW-routed manual pipelines (set the variable when
# dispatching to say which flow a run belongs to; jobs may rule on
# it the way the conformance rigs do on CI_COMMIT_MESSAGE).
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == "main"
    - if: $CI_COMMIT_TAG =~ /^packages\/.+\/v\d/
    - if: $LIVERY_WORKFLOW

stages: [check, release]

{{ required_context }}:
  stage: check
  image: ghcr.io/astral-sh/uv:python{{ python_versions[0] }}-bookworm
  rules:
    - if: $CI_COMMIT_TAG
      when: never
    - when: on_success
  script:
    - uv sync --locked
    - uv run --no-sync fm check

release:
  stage: release
  image: ghcr.io/astral-sh/uv:python{{ python_versions[0] }}-bookworm
  rules:
    - if: $CI_COMMIT_TAG =~ /^packages\/.+\/v\d/
  script:
    # The first verify carries the verdict unpiped; the second run is
    # a value read for the package name. Publishing is by token
    # (UV_PUBLISH_TOKEN CI variable) to the configured index: no
    # trusted publishing here.
    - git fetch --tags
    - uv sync --locked
    - uv run --no-sync fm release.verify "$CI_COMMIT_TAG"
    - name=$(uv run --no-sync fm release.verify "$CI_COMMIT_TAG" | awk '/verified:/{print $2}')
    - uv build --package "$name" --out-dir dist
    - uv publish --publish-url "{{ publish_index }}" dist/*
