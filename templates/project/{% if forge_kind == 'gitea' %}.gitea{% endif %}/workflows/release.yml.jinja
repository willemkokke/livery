name: release

# The train: push a tag shaped packages/<pkg>/v<semver> and only that
# package releases. Tags are immutable and pushed alone. Publishing
# is by token (UV_PUBLISH_TOKEN secret) to the configured index:
# Gitea has no trusted publishing.
on:
  push:
    tags: ["packages/*/v*"]

jobs:
  publish:
    runs-on: {{ runners[0] }}
    steps:
      - uses: actions/checkout@v4
        with:
          # The verify step checks floors against released tags.
          fetch-depth: 0
      - name: Install uv
        run: curl -LsSf https://astral.sh/uv/install.sh | sh
      - name: Sync (locked)
        run: $HOME/.local/bin/uv sync --locked
      - name: Verify tag against package
        run: $HOME/.local/bin/uv run --no-sync fm release.verify "${{ '{{' }} github.ref_name {{ '}}' }}"
      - name: Build
        # The verify above carries the verdict unpiped; this second
        # run is a value read for the package name.
        run: |
          name=$($HOME/.local/bin/uv run --no-sync fm release.verify "${{ '{{' }} github.ref_name {{ '}}' }}" | awk '/verified:/{print $2}')
          $HOME/.local/bin/uv build --package "$name" --out-dir dist
      - name: Publish (token, configured index)
        env:
          UV_PUBLISH_TOKEN: ${{ '{{' }} secrets.UV_PUBLISH_TOKEN {{ '}}' }}
        run: $HOME/.local/bin/uv publish --publish-url "{{ publish_index }}" dist/*
