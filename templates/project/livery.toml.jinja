# The workspace contract, ecosystem-neutral. The workshop reads this;
# nothing else is authoritative about workspace shape.

[workspace]
# The layers, in precedence order. Discovery is this list and nothing
# else: a layer not named here is not mounted, however it got
# installed.
layers = [{% for layer in layers %}"{{ layer }}"{% if not loop.last %}, {% endif %}{% endfor %}]

[forge]
kind = "{{ forge_kind }}"
owner = "{{ forge_owner }}"

[ci]
runners = [{% for runner in runners %}"{{ runner }}"{% if not loop.last %}, {% endif %}{% endfor %}]
