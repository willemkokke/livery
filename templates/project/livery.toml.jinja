# The workspace contract, ecosystem-neutral. The workshop reads this;
# nothing else is authoritative about workspace shape.

[workspace]
# The layers, in precedence order. Discovery is this list and nothing
# else: a layer not named here is not mounted, however it got
# installed.
layers = [{% for layer in layers %}"{{ layer }}"{% if not loop.last %}, {% endif %}{% endfor %}]
# Where the rendered files come from: a directory relative to this
# root, or a git URL (a fork, at your own risk). The update wave
# follows this value.
templates = "{{ templates_source }}"

[forge]
kind = "{{ forge_kind }}"
owner = "{{ forge_owner }}"
{% if forge_url %}url = "{{ forge_url }}"
{% endif %}
[ci]
runners = [{% for runner in runners %}"{{ runner }}"{% if not loop.last %}, {% endif %}{% endfor %}]
# The one status name branch protection requires, spelled by contract
# so each forge's CI renders it rather than anyone retyping it.
required_context = "{{ required_context }}"
