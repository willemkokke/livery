{
  "name": "uv",
  "description": "Python package and project manager (the toolchain's backbone)",
  "kind": "archive",
  "min_version": "",
  "hosts": [
    "macos-arm",
    "macos-x64",
    "linux-x64",
    "linux-arm",
    "windows-x64"
  ],
  "layout": {
    "entry_points": [
      "uv",
      "uvx"
    ],
    "paths": [
      "."
    ]
  },
  "host_layouts": {
    "macos-arm": {
      "root": "uv-aarch64-apple-darwin"
    },
    "macos-x64": {
      "root": "uv-x86_64-apple-darwin"
    },
    "linux-x64": {
      "root": "uv-x86_64-unknown-linux-gnu"
    },
    "linux-arm": {
      "root": "uv-aarch64-unknown-linux-gnu"
    },
    "windows-x64": {
      "entry_points": [
        "uv.exe",
        "uvx.exe"
      ]
    }
  }
}
