{
  "name": "bun",
  "description": "Node-compatible runtime for the node lint tools (no node binary; a node shim resolves to bun)",
  "kind": "archive",
  "min_version": "",
  "hosts": [
    "macos-arm",
    "macos-x64",
    "linux-x64",
    "linux-arm",
    "windows-x64"
  ],
  "layout": {
    "entry_points": [
      "bun"
    ],
    "paths": [
      "."
    ],
    "shims": {
      "node": "bun"
    }
  },
  "host_layouts": {
    "macos-arm": {
      "root": "bun-darwin-aarch64"
    },
    "macos-x64": {
      "root": "bun-darwin-x64"
    },
    "linux-x64": {
      "root": "bun-linux-x64"
    },
    "linux-arm": {
      "root": "bun-linux-aarch64"
    },
    "windows-x64": {
      "root": "bun-windows-x64",
      "entry_points": [
        "bun.exe"
      ]
    }
  }
}
