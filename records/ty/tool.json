{
  "name": "ty",
  "description": "Astral ty — fast Python type checker (replaces basedpyright)",
  "kind": "archive",
  "min_version": "",
  "hosts": [
    "macos-arm",
    "macos-x64",
    "linux-x64",
    "linux-arm",
    "windows-x64"
  ],
  "layout": {
    "paths": [
      "."
    ]
  },
  "host_layouts": {
    "macos-arm": {
      "root": "ty-aarch64-apple-darwin"
    },
    "macos-x64": {
      "root": "ty-x86_64-apple-darwin"
    },
    "linux-x64": {
      "root": "ty-x86_64-unknown-linux-gnu"
    },
    "linux-arm": {
      "root": "ty-aarch64-unknown-linux-gnu"
    }
  }
}
