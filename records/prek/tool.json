{
  "name": "prek",
  "description": "pre-commit runner, installed from the prebuilt release binary",
  "kind": "archive",
  "min_version": "",
  "hosts": [
    "macos-arm",
    "macos-x64",
    "linux-x64",
    "linux-arm",
    "windows-x64"
  ],
  "layout": {
    "entry_points": [
      "prek"
    ],
    "paths": [
      "."
    ]
  },
  "host_layouts": {
    "macos-arm": {
      "root": "prek-aarch64-apple-darwin"
    },
    "macos-x64": {
      "root": "prek-x86_64-apple-darwin"
    },
    "linux-x64": {
      "root": "prek-x86_64-unknown-linux-gnu"
    },
    "linux-arm": {
      "root": "prek-aarch64-unknown-linux-gnu"
    },
    "windows-x64": {
      "entry_points": [
        "prek.exe"
      ]
    }
  }
}
